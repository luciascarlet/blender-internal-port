static float spec(float inp, int hard)	
{
	float b1;
	
	if (inp>=1.0f) return 1.0f;
	else if (inp<=0.0f) return 0.0f;
	
	b1= inp*inp;
	/* avoid FPE */
	if (b1<0.01f) b1= 0.01f;
	
	if ((hard & 1)==0)  inp= 1.0f;
	if (hard & 2)  inp*= b1;
	b1*= b1;
	if (hard & 4)  inp*= b1;
	b1*= b1;
	if (hard & 8)  inp*= b1;
	b1*= b1;
	if (hard & 16) inp*= b1;
	b1*= b1;

	/* avoid FPE */
	if (b1<0.001f) b1= 0.0f;

	if (hard & 32) inp*= b1;
	b1*= b1;
	if (hard & 64) inp*=b1;
	b1*= b1;
	if (hard & 128) inp*=b1;

	if (b1<0.001f) b1= 0.0f;

	if (hard & 256) {
		b1*= b1;
		inp*=b1;
	}

	return inp;
}

